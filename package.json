{
  "name": "shiprocket-mcp",
  "version": "1.0.0",
  "main": "index.js",
  "mcpName": "io.github.bfrs/shiprocket-mcp",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/main.ts --watch",
    "dev:http": "MCP_TRANSPORT=HTTP TS_NODE_CACHE=false ts-node-dev -r tsconfig-paths/register src/main.ts --watch",
    "build": "tsc",
    "test": "vitest run",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "start:http": "MCP_TRANSPORT=HTTP node -r tsconfig-paths/register dist/main.js",
    "inspector": "npx @modelcontextprotocol/inspector node -r tsconfig-paths/register dist/main.js",
    "inspector:http": "npx @modelcontextprotocol/inspector"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
