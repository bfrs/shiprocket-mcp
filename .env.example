APP_PORT=3000
MCP_TRANSPORT=HTTP

# ── stdio mode only ──────────────────────────────────────────────────────────
SELLER_EMAIL=
SELLER_PASSWORD=

# ── HTTP / OAuth mode ────────────────────────────────────────────────────────
# Public base URL of this server; required when NODE_ENV=production
OAUTH_ISSUER=
# Encryption key for seller tokens at rest (base64, 32 bytes). Required in production.
# Generate with:  openssl rand -base64 32
TOKEN_ENC_KEY=
# Redis (omit REDIS_HOST to use the in-memory store — development only)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false