# Required: Shiprocket account credentials
# Set EITHER SELLER_TOKEN (skip login entirely) OR both SELLER_EMAIL + SELLER_PASSWORD.
SELLER_EMAIL=your-shiprocket-email@example.com
SELLER_PASSWORD=your-shiprocket-password

# Optional: Pre-issued Shiprocket token. When set, login is skipped and this token
# is used as-is (no refresh). SELLER_EMAIL/SELLER_PASSWORD are not required.
# SELLER_TOKEN=

# Optional: HTTP server port (default: 3000)
PORT=3000

# Optional: MCP auth token for HTTP transport security
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: Override Shiprocket API base URLs
# API_BASE_SHIPROCKET=https://apiv2.shiprocket.in
# API_BASE_SERVICEABILITY=https://serviceability.shiprocket.in

# Optional: Override the base path used for the auth login endpoint.
# Default: ${API_BASE_SHIPROCKET}/v1/external (legacy)
# For the new endpoint on apiv2.shiprocket.co set:
#   SR_API_BASE=https://apiv2.shiprocket.co/v1
# SR_API_BASE=https://apiv2.shiprocket.in/v1/external

# Optional: Log level (default: info)
# LOG_LEVEL=info
